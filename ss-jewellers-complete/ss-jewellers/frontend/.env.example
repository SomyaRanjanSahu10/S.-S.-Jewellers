# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ssjewellers.in
NEXT_PUBLIC_SITE_NAME=S.S. Jewellers

# ── API ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.ssjewellers.in/api
# For local development:
# NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ── Razorpay (public key only on frontend) ────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# For test mode:
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ── Cloudinary (public read only) ────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ── Google Analytics ──────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── WhatsApp ──────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUM=+914023456789

# ── Feature flags ────────────────────────────────────────
NEXT_PUBLIC_ENABLE_AI_STYLIST=true
NEXT_PUBLIC_MAINTENANCE_MODE=false
